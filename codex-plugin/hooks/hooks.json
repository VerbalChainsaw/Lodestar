{
  "description": "Load Lodestar state and authorize exact Lodestar continuity commands.",
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "commandWindows": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "timeout": 10
      }]
    }],
    "PreToolUse": [{
      "matcher": "lodestar_handoff_(arm|status|checkpoint|now|disarm)$",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "commandWindows": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "timeout": 10
      }]
    }],
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "commandWindows": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "timeout": 20
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "commandWindows": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "timeout": 10
      }]
    }]
  }
}
