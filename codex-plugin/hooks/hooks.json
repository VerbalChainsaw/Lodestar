{
  "description": "Load unified Lodestar state and authorize exact handoff commands.",
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "commandWindows": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "timeout": 10,
        "additionalContextLimit": 12000
      }]
    }],
    "PreToolUse": [{
      "matcher": "handoff_now$",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "commandWindows": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "timeout": 10
      }]
    }],
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "commandWindows": "node \"${PLUGIN_ROOT}/scripts/lodestar-hook.mjs\"",
        "timeout": 20,
        "additionalContextLimit": 16384
      }]
    }]
  }
}
