{
  "name": "lodestar-agent-context",
  "version": "0.6.0",
  "description": "Local deterministic context and project discovery for coding agents",
  "type": "module",
  "bin": {
    "agentctx": "./agentctx.mjs",
    "lodestar-install": "./install.mjs",
    "agentctx-install-codex": "./tools/install-codex.mjs",
    "agentctx-inventory-codex": "./tools/inventory-codex.mjs",
    "agentctx-migrate-legacy": "./tools/migrate-legacy.mjs",
    "agentctx-migrate-projects": "./tools/migrate-projects.mjs",
    "agentctx-profile-projects": "./tools/profile-projects.mjs",
    "agentctx-rollback-codex": "./tools/rollback-codex.mjs",
    "lodestar-benchmark": "./tools/benchmark-lift.mjs",
    "lodestar-performance": "./tools/benchmark-performance.mjs",
    "lodestar-category-benchmark": "./tools/benchmark-category.mjs"
  },
  "files": [
    "agentctx.mjs",
    "install.mjs",
    "install.ps1",
    "install.sh",
    "lib/",
    "tools/",
    "schema/",
    "templates/",
    "benchmarks/category/",
    "docs/category-benchmark.md",
    "docs/benchmarks.md",
    "docs/evaluation.md",
    "docs/performance.md",
    "docs/maintenance.md",
    "docs/plans/2026-07-30-lodestar-category-benchmark-plan.md",
    "docs/plans/2026-07-30-lodestar-v0.5-project-readiness-implementation.md",
    "docs/plans/2026-07-30-lodestar-integrity-maintenance-codeplan.md",
    "docs/plans/2026-07-30-lodestar-v0.6-trust-recovery-codeplan.md",
    "docs/releases/v0.5.0.md",
    "docs/releases/v0.6.0.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "benchmark:lift": "node tools/benchmark-lift.mjs",
    "benchmark:performance": "node tools/benchmark-performance.mjs",
    "benchmark:category": "node tools/benchmark-category.mjs",
    "doctor": "node agentctx.mjs doctor",
    "install:codex": "node agentctx.mjs install-codex",
    "inventory:codex": "node agentctx.mjs inventory-codex",
    "migrate:projects": "node agentctx.mjs migrate-projects",
    "profile:projects": "node agentctx.mjs profile-projects",
    "rollback:codex": "node agentctx.mjs rollback",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "coding-agents",
    "context",
    "codex",
    "cli",
    "local-first"
  ],
  "author": "VerbalChainsaw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VerbalChainsaw/Lodestar.git"
  },
  "homepage": "https://github.com/VerbalChainsaw/Lodestar#readme",
  "bugs": {
    "url": "https://github.com/VerbalChainsaw/Lodestar/issues"
  }
}
