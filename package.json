{
  "name": "lodestar-agent-context",
  "version": "2.0.0",
  "description": "Local contract-5 project context, evidence, decisions, work, and continuity",
  "type": "module",
  "bin": {
    "lodestar": "lodestar.mjs"
  },
  "files": [
    "lodestar.mjs",
    "src/",
    "!src/continuity-schema.mjs",
    "!src/markers.mjs",
    "managed-assets/",
    "codex-plugin/",
    "docs/agent-bootstrap.json",
    "docs/limitations.md",
    "docs/schema.md",
    "docs/releases/v2.0.0.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "assets:build": "node scripts/build-managed-assets.mjs --write",
    "assets:check": "node scripts/build-managed-assets.mjs --check",
    "test": "npm run assets:check && node --test",
    "pack:check": "npm pack --dry-run --json"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agents",
    "context",
    "context-registry",
    "handoff",
    "multi-agent",
    "sqlite",
    "cli",
    "local-first",
    "offline",
    "json",
    "machine-readable"
  ],
  "author": "VerbalChainsaw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VerbalChainsaw/Lodestar.git"
  },
  "homepage": "https://github.com/VerbalChainsaw/Lodestar#readme",
  "bugs": {
    "url": "https://github.com/VerbalChainsaw/Lodestar/issues"
  }
}
